---
// Small inline-SVG country flag (simplified for icon size). No external assets.
import { COUNTRY_NAMES, type CountryCode } from '../lib/countries';

interface Props {
  code: CountryCode;
  title?: string;
}

const { code, title } = Astro.props;


function star(cx: number, cy: number, r: number, rot = 0): string {
  const pts: string[] = [];
  for (let i = 0; i < 10; i++) {
    const rad = i % 2 === 0 ? r : r * 0.382;
    const a = -Math.PI / 2 + rot + (i * Math.PI) / 5;
    pts.push(`${(cx + rad * Math.cos(a)).toFixed(2)},${(cy + rad * Math.sin(a)).toFixed(2)}`);
  }
  return `M${pts.join('L')}Z`;
}

const usStripes = Array.from({ length: 6 }, (_, i) => (i * 2 + 1) * (20 / 13));
const usStars: [number, number][] = [];
for (let row = 0; row < 5; row++) {
  for (let col = 0; col < (row % 2 ? 4 : 5); col++) {
    usStars.push([1.3 + col * 2.6 + (row % 2 ? 1.3 : 0), 1.3 + row * 2.15]);
  }
}

const label = title ?? COUNTRY_NAMES[code];
---
<svg class="flag" viewBox={code === 'GB' ? '0 0 60 30' : '0 0 30 20'} preserveAspectRatio="none" role="img" aria-label={label}>
  <title>{label}</title>
  {code === 'SE' && (
    <>
      <rect width="30" height="20" fill="#006AA7" />
      <rect x="9" width="4" height="20" fill="#FECC02" />
      <rect y="8" width="30" height="4" fill="#FECC02" />
    </>
  )}
  {code === 'DE' && (
    <>
      <rect width="30" height="20" fill="#000" />
      <rect y="6.67" width="30" height="6.67" fill="#DD0000" />
      <rect y="13.33" width="30" height="6.67" fill="#FFCE00" />
    </>
  )}
  {code === 'NO' && (
    <>
      <rect width="30" height="20" fill="#BA0C2F" />
      <rect x="8" width="5" height="20" fill="#fff" />
      <rect y="7.5" width="30" height="5" fill="#fff" />
      <rect x="9.25" width="2.5" height="20" fill="#00205B" />
      <rect y="8.75" width="30" height="2.5" fill="#00205B" />
    </>
  )}
  {code === 'BE' && (
    <>
      <rect width="10" height="20" fill="#000" />
      <rect x="10" width="10" height="20" fill="#FDDA24" />
      <rect x="20" width="10" height="20" fill="#EF3340" />
    </>
  )}
  {code === 'ES' && (
    <>
      <rect width="30" height="20" fill="#AA151B" />
      <rect y="5" width="30" height="10" fill="#F1BF00" />
    </>
  )}
  {code === 'CN' && (
    <>
      <rect width="30" height="20" fill="#EE1C25" />
      <path d={star(5, 5, 3)} fill="#FFFF00" />
      <path d={star(10, 2, 1, 0.9)} fill="#FFFF00" />
      <path d={star(12, 4, 1, 1.4)} fill="#FFFF00" />
      <path d={star(12, 7, 1, 0)} fill="#FFFF00" />
      <path d={star(10, 9, 1, 0.5)} fill="#FFFF00" />
    </>
  )}
  {code === 'US' && (
    <>
      <rect width="30" height="20" fill="#B22234" />
      {usStripes.map((y) => <rect y={y} width="30" height={20 / 13} fill="#fff" />)}
      <rect width="12" height={(20 / 13) * 7} fill="#3C3B6E" />
      {usStars.map(([x, y]) => <circle cx={x * (12 / 13)} cy={y} r="0.45" fill="#fff" />)}
    </>
  )}
  {code === 'GB' && (
    <>
      <rect width="60" height="30" fill="#012169" />
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="2" />
      <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
      <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
    </>
  )}
</svg>

<style>
  .flag {
    display: inline-block;
    width: 1.35rem;
    height: 0.9rem;
    border-radius: 2px;
    box-shadow: 0 0 0 1px var(--color-border);
    vertical-align: middle;
    flex-shrink: 0;
  }
</style>
