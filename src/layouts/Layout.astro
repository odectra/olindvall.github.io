---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  tags?: string[];
}

const {
  title,
  description = 'Personal site of Oskar Lindvall — Associate Director at AstraZeneca, endurance athlete, and builder of small web tools. Reflections on leadership, training, and learning.',
  image = '/images/about/oskar-portrait.jpg',
  type = 'website',
  publishDate,
  tags = [],
} = Astro.props;

const pageTitle = `${title} — Oskar Lindvall`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Oskar Lindvall',
  url: Astro.site?.toString(),
  image: ogImageURL.toString(),
  jobTitle: 'Associate Director Development Quality — Quality Systems',
  worksFor: {
    '@type': 'Organization',
    name: 'AstraZeneca',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Chalmers University of Technology',
  },
  sameAs: [
    'https://www.linkedin.com/in/oskar-lindvall-35735854/',
    'https://www.strava.com/athletes/46830295',
    'https://www.goodreads.com/user/show/127870918-oskar-lindvall',
    'https://github.com/odectra',
  ],
};

const articleSchema =
  type === 'article' && publishDate
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImageURL.toString(),
        datePublished: publishDate.toISOString(),
        author: {
          '@type': 'Person',
          name: 'Oskar Lindvall',
          url: Astro.site?.toString(),
        },
        keywords: tags.join(', '),
        mainEntityOfPage: canonicalURL.toString(),
      }
    : null;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Oskar Lindvall" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {type === 'article' && publishDate && (
      <meta property="article:published_time" content={publishDate.toISOString()} />
    )}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..600,0..100&family=Inter:wght@400;500;600&display=swap"
    />
    <style>
      :root {
        --font-serif: 'Fraunces', ui-serif, Georgia, serif;
        --font-sans: 'Inter', ui-sans-serif, system-ui, sans-serif;
        --radius: 0.5rem;

        --color-bg: oklch(97.6% 0.014 78);
        --color-text: oklch(24% 0.02 55);
        --color-text-muted: oklch(46% 0.024 55);
        --color-border: oklch(89% 0.015 70);
        --color-card: oklch(99% 0.009 78);
        --color-accent: oklch(53% 0.12 38);
        --color-link: var(--color-text);
        --shadow-card: 0 1px 2px oklch(24% 0.02 55 / 0.05), 0 4px 12px oklch(24% 0.02 55 / 0.04);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --color-bg: oklch(16% 0.018 48);
          --color-text: oklch(95.5% 0.012 75);
          --color-text-muted: oklch(69% 0.02 60);
          --color-border: oklch(31% 0.02 50);
          --color-card: oklch(20.5% 0.018 50);
          --color-accent: oklch(72% 0.13 55);
          --shadow-card: 0 1px 2px oklch(0% 0 0 / 0.2), 0 4px 12px oklch(0% 0 0 / 0.16);
        }
      }

      * { box-sizing: border-box; }

      html {
        background: var(--color-bg);
      }

      body {
        margin: 0 auto;
        max-width: 680px;
        padding: 2rem 1.5rem 4rem;
        background: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-sans);
        font-feature-settings: 'ss01', 'cv11';
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
      }

      h1, h2, h3, h4 {
        font-family: var(--font-serif);
        font-weight: 400;
        letter-spacing: -0.01em;
      }

      a {
        color: var(--color-link);
      }

      a:hover {
        color: var(--color-accent);
      }

      main :global(a) {
        color: var(--color-accent);
        text-decoration-color: var(--color-border);
      }

      main :global(a:hover) {
        text-decoration-color: currentColor;
      }

      header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 3rem;
      }

      .wordmark {
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--color-text-muted);
      }

      .wordmark:hover {
        color: var(--color-text);
      }

      nav ul {
        list-style: none;
        display: flex;
        gap: 1.25rem;
        margin: 0;
        padding: 0;
        font-size: 0.9rem;
      }

      nav a {
        text-decoration: none;
        color: var(--color-text-muted);
      }

      nav a:hover {
        color: var(--color-text);
      }

      main {
        min-height: 50vh;
      }

      footer {
        margin-top: 4rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.85rem;
        color: var(--color-text-muted);
      }
    </style>
  </head>
  <body>
    <header>
      <a class="wordmark" href="/">Oskar Lindvall</a>
      <nav>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/thoughts">Thoughts</a></li>
          <li><a href="/reflections">Reflections</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} Oskar Lindvall</p>
    </footer>
  </body>
</html>
