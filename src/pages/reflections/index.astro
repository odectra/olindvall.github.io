---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const reflections = (await getCollection('reflections')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Layout title="Reflections">
  <h1>Reflections</h1>
  <ul class="reflection-list">
    {reflections.map((entry) => (
      <li>
        <a href={`/reflections/${entry.id}`}>{entry.data.title}</a>
        <div class="meta">
          <span class="date">{entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          {entry.data.tags.length > 0 && (
            <span class="tags">{entry.data.tags.join(', ')}</span>
          )}
        </div>
        <p class="description">{entry.data.description}</p>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .reflection-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .reflection-list li {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .reflection-list a {
    text-decoration: none;
    font-size: 1.1rem;
  }

  .reflection-list a:hover {
    text-decoration: underline;
  }

  .meta {
    margin-top: 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    display: flex;
    gap: 0.75rem;
  }

  .description {
    margin-top: 0.5rem;
  }
</style>
