---
import Layout from '../layouts/Layout.astro';
import StravaFeed from '../components/StravaFeed.astro';
---
<Layout title="About">
  <h1>About</h1>

  <div class="photo-placeholder" role="img" aria-label="Photo placeholder">Photo</div>

  <section>
    <h2>Professional bio</h2>
    <p>I lead quality systems and digital initiatives within CMC Development at AstraZeneca, supporting a large user base across Sweden and the UK. My background spans consulting, PMO leadership, and now quality systems in a regulated pharma environment — with a consistent thread of translating between technical, commercial, and regulatory worlds. I studied Management and Economics of Innovation and Mechanical Engineering at Chalmers.</p>
  </section>

  <section>
    <h2>Personal bio</h2>
    <p>Outside of work I'm usually training for something — running or swimrun, most often — or building small tools and apps for myself and friends. I live with my partner and daughter, with our second daughter due soon. This site is where I collect the parts of me that don't fit neatly into a CV.</p>
  </section>

  <section>
    <h2>Links</h2>
    <ul class="links">
      <li><a href="https://www.linkedin.com/in/placeholder" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a href="https://www.strava.com/athletes/placeholder" target="_blank" rel="noopener noreferrer">Strava</a></li>
      <li><a href="https://www.goodreads.com/user/show/placeholder" target="_blank" rel="noopener noreferrer">Goodreads</a></li>
    </ul>
  </section>

  <section>
    <h2>Strava activity</h2>
    <StravaFeed />
  </section>
</Layout>

<style>
  section {
    margin-top: 2.5rem;
  }

  .photo-placeholder {
    margin-top: 1.5rem;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    border: 1px dashed var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
</style>
