---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: 'Leaflet',
    category: 'Journal',
    description: "A digital notebook for capturing thoughts in seconds — typed or spoken — organized into notebooks you can lock, encrypt, and share. The idea came because I wanted to write more. I also wanted to create a shared notebook with my wife to document the first year of our second daugther. It is possible to export (with or without voice recordings), so notes never have to stay stuck on a distant server — you'll be able to pull everything out, keep the history or drop it, and turn it into a local diary (or a book for your daughter) if you'd rather.",
    href: 'https://leaflet.olindvall.se',
    writeup: '/reflections/leaflet-family-journal',
    image: '/images/projects/leaflet-start-page.jpg',
    imageAlt: 'Leaflet landing page — "A quiet place to think." with a Start writing button',
  },
  {
    name: 'Financial Business Case',
    category: 'Finance',
    description: 'A web tool for building product and SaaS business cases — revenue forecasting, cost modelling, and investment appraisal by discounted cash flow, IRR and payback. Rebuilt from an Excel template I built working as Product Manager at Mentice, but it now includes sensitivity analysis and some further improvements compared to the original tool. Tech: React, TypeScript, Vite.',
    href: 'https://odectra.github.io/financial-business-case/?tool=business-case',
    writeup: '/reflections/financial-business-case-tool',
    image: 'https://odectra.github.io/financial-business-case/previews/business-case.png',
    imageAlt: 'Financial Business Case tool preview — revenue, cost, and DCF forecasting inputs and charts',
  },
  {
    name: 'Property Investment (Sweden)',
    category: 'Finance',
    description: 'Values a Swedish rental property two independent ways and compares owning it privately against through an AB, side by side — full mortgage, tax and exit modelling, including stamp duty, fastighetsavgift, and selling via shares (paketering). Tech: React, TypeScript, Vite.',
    href: 'https://odectra.github.io/financial-business-case/?tool=property',
    writeup: '/reflections/property-investment-claude-code',
    image: 'https://odectra.github.io/financial-business-case/previews/property.png',
    imageAlt: 'Property Investment tool preview — private vs. AB ownership comparison with mortgage and tax modelling',
  },
  {
    name: 'Stegvis — My First Stock Portfolio',
    category: 'Finance',
    description: "Built from my own experience starting to invest: buy and hold, diversify to manage risk — but not enough capital to buy everything at once, so each purchase had to be whatever gave the best value that day while still fitting the plan. Stegvis picks a risk profile, builds a diversified 20-30 stock target portfolio, and shows what to buy next with whatever small amount you have to save. Not financial advice — just the concept that got me started.",
    href: 'https://odectra.github.io/Portfoljbygge/',
    writeup: '/reflections/stegvis-stock-portfolio',
    image: 'https://odectra.github.io/Portfoljbygge/previews/dashboard.png',
    imageAlt: 'Stegvis dashboard preview — portfolio value, progress toward target, sector allocation and recent investments',
  },
  {
    name: 'Fuel calculator',
    category: 'Training',
    description: 'A calculator for endurance races — dial in your race duration, intensity, and gut training level to get a carbs-per-hour target, then see exactly how much white sugar, maltodextrin, and salt to mix to hit it. Built out of my own swimrun and marathon training.',
    href: '/projects/fuel-calculator',
    image: '/images/projects/fuel-calculator.png',
    imageAlt: 'Endurance Fuel Calculator — race duration, intensity, and gut training inputs with a carb target slider',
  },
  {
    name: 'Savings & FIRE calculator',
    category: 'Finance',
    description: 'Visualize how regular saving and compound interest play out over time — plug in a starting amount, monthly contribution, and expected return to see the long-term curve. Switch to the FIRE tab to estimate how much you need for financial independence, and how long it will take, based on your expenses and savings rate. Choose your currency.',
    href: '/projects/savings-calculator',
    image: '/images/projects/savings-calculator.png',
    imageAlt: 'Savings & FIRE Calculator — starting amount, monthly contribution, and return inputs with projected future value',
  },
  {
    name: 'Base Training Program',
    category: 'Training',
    description: 'My current rolling 5-week base training program for swimrun and running — running, ski erg, swimming and strength. Filter by discipline or week, switch between a list and calendar view, and see weekly training volume charted by discipline.',
    href: '/projects/training-program',
    image: '/images/projects/training-program.png',
    imageAlt: 'Base Training Program — weekly volume summary and a filterable, discipline-tagged session list',
  },
];

const categories = [...new Set(projects.map((p) => p.category))].sort();
---
<Layout
  title="Projects"
  description="Web tools built by Oskar Lindvall — a journaling app, financial business case and property investment calculators, and training tools for endurance racing."
>
  <h1>Projects</h1>

  <div class="filters">
    <button type="button" class="chip active" data-category="All">All</button>
    {categories.map((c) => (
      <button type="button" class="chip" data-category={c}>{c}</button>
    ))}
  </div>

  <ul class="project-list" id="project-list">
    {projects.map((project) => (
      <li class="project-card" data-category={project.category}>
        {project.image && (
          <img class="project-image" src={project.image} alt={project.imageAlt} loading="lazy" />
        )}
        <span class="category">{project.category}</span>
        <h2>{project.name}</h2>
        {project.writeup && (
          <a class="writeup-link" href={project.writeup}>Read the writeup →</a>
        )}
        <p>{project.description}</p>
        {project.href ? (
          project.href.startsWith('/') ? (
            <a class="status status-live" href={project.href}>Try it →</a>
          ) : (
            <a class="status status-live" href={project.href} target="_blank" rel="noopener noreferrer">Visit ↗</a>
          )
        ) : (
          <span class="status">Coming soon</span>
        )}
      </li>
    ))}
  </ul>

  <p class="empty-state" id="empty-state" hidden>No projects in this category yet.</p>
</Layout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.filters .chip');
  const cards = document.querySelectorAll<HTMLLIElement>('#project-list .project-card');
  const emptyState = document.getElementById('empty-state')!;

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');

      const category = chip.dataset.category!;
      let visible = 0;
      cards.forEach((card) => {
        const match = category === 'All' || card.dataset.category === category;
        card.hidden = !match;
        if (match) visible++;
      });
      emptyState.hidden = visible > 0;
    });
  });
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.75rem 0 0;
  }

  .chip {
    font: inherit;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .chip:hover {
    border-color: var(--color-accent);
  }

  .chip.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg);
  }

  .empty-state {
    padding: 3rem 0;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .project-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .project-card {
    padding: 1.25rem;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }

  .project-image {
    display: block;
    width: calc(100% + 2.5rem);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    margin: -1.25rem -1.25rem 1rem;
    border-radius: var(--radius) var(--radius) 0 0;
    border-bottom: 1px solid var(--color-border);
  }

  .project-card h2 {
    margin: 0.25rem 0 0.5rem;
    font-size: 1.1rem;
  }

  .category {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .writeup-link {
    display: inline-block;
    margin: 0.1rem 0 0.5rem;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--color-accent);
  }

  .writeup-link:hover {
    text-decoration: underline;
  }

  .status {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    padding: 0.2rem 0.5rem;
  }

  .status-live {
    text-decoration: none;
    border-style: solid;
    color: var(--color-text);
  }

  .status-live:hover {
    color: var(--color-accent);
  }
</style>
