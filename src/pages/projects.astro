---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: 'Leaflet',
    category: 'Journal',
    description: "A digital notebook for capturing thoughts in seconds — typed or spoken — organized into notebooks you can lock, encrypt, and share. The idea came because I wanted to write more. I also wanted to create a shared notebook with my wife to document the first year of our second daugther. It is possible to export (with or without voice recordings), so notes never have to stay stuck on a distant server — you'll be able to pull everything out, keep the history or drop it, and turn it into a local diary (or a book for your daughter) if you'd rather.",
    href: 'https://leaflet.olindvall.se',
    image: 'https://screenshot2.lovable.dev/b1ce1a45-5197-41c0-ae32-93db5fc40187/id-preview-a3733226--079104c6-4ec2-4ad6-9756-c7afd66708fb.lovable.app-1785699389026.png',
    imageAlt: 'Leaflet landing page — "A quiet place to think." with a Start writing button',
  },
  {
    name: 'Business case forecaster',
    category: 'Finance',
    description: "A financial business case template I originally built as a Product Manager at Mentice to fit our operations, rebuilt for the web. It's designed to be easy for other Product Managers to use — forecast an income statement, run a discounted cash flow (DCF), and calculate IRR and payback period for major product investments (CapEx), across multiple revenue streams including products and SaaS. Model best, base, and conservative scenarios from R&D CapEx, COGS, WACC, and customer churn, and get terminal value and capex depreciation out the other end — plus charts you can drop straight into a presentation.",
  },
  {
    name: 'Fuel calculator',
    category: 'Training',
    description: 'A calculator for endurance races — dial in your race duration and target carbs-per-hour to get a fueling plan you can actually follow on race day. Built out of my own swimrun and marathon training.',
  },
  {
    name: 'Savings calculator',
    category: 'Finance',
    description: 'A simple tool to visualize how regular saving and compound interest play out over time — plug in a starting amount, monthly contribution, and expected return to see the long-term curve.',
  },
  {
    name: 'FIRE calculator',
    category: 'Finance',
    description: 'Estimate your path to financial independence — enter your savings rate, expenses, and expected returns to see roughly when your investments could cover your living costs.',
  },
];
---
<Layout title="Projects">
  <h1>Projects</h1>
  <ul class="project-list">
    {projects.map((project) => (
      <li class="project-card">
        {project.image && (
          <img class="project-image" src={project.image} alt={project.imageAlt} loading="lazy" />
        )}
        <span class="category">{project.category}</span>
        <h2>{project.name}</h2>
        <p>{project.description}</p>
        {project.href ? (
          <a class="status status-live" href={project.href} target="_blank" rel="noopener noreferrer">Visit ↗</a>
        ) : (
          <span class="status">Coming soon</span>
        )}
      </li>
    ))}
  </ul>
</Layout>

<style>
  .project-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .project-card {
    padding: 1.25rem;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .project-image {
    display: block;
    width: calc(100% + 2.5rem);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    margin: -1.25rem -1.25rem 1rem;
    border-radius: var(--radius) var(--radius) 0 0;
    border-bottom: 1px solid var(--color-border);
  }

  .project-card h2 {
    margin: 0.25rem 0 0.5rem;
    font-size: 1.1rem;
  }

  .category {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .status {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    padding: 0.2rem 0.5rem;
  }

  .status-live {
    text-decoration: none;
    border-style: solid;
    color: var(--color-text);
  }

  .status-live:hover {
    color: var(--color-accent);
  }
</style>
