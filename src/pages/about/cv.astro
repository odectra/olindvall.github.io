---
import Layout from '../../layouts/Layout.astro';
import CountryTag from '../../components/CountryTag.astro';
import InvolvementIcon from '../../components/InvolvementIcon.astro';
import { formatDuration, formatPeriod, formatYears, monthsCovered, monthsIn, type Period } from '../../lib/cv-duration';
import { INVOLVEMENTS, INVOLVEMENT_LABELS, type CountryCode, type Involvement } from '../../lib/countries';

interface RoleCountry {
  code: CountryCode;
  kinds: Involvement[];
}

interface Role extends Period {
  id: string;
  title: string;
  org: string;
  logo?: string;
  logoImage?: string;
  location?: string;
  current?: boolean;
  countries: RoleCountry[];
  // Client assignments (Knightec) or, with `progression`, promotions within one company.
  assignments?: Role[];
  progression?: boolean;
}


// Dates are 'YYYY-MM', inclusive. Omit `end` for an ongoing role.
// `countries`: where the role was based, led team members, visited clients or had customers.
const experience: Role[] = [
  {
    id: 'az-ad',
    title: 'Associate Director Development Quality — Quality Systems',
    org: 'AstraZeneca',
    logoImage: '/images/logos/astrazeneca.png',
    start: '2023-07',
    location: 'Mölndal',
    current: true,
    countries: [
      { code: 'SE', kinds: ['based', 'team'] },
      { code: 'GB', kinds: ['team'] },
    ],
  },
  {
    id: 'mentice',
    title: 'Mentice',
    org: 'Mentice',
    logoImage: '/images/logos/mentice.png',
    start: '2019-06',
    end: '2023-07',
    location: 'Gothenburg, Sweden',
    progression: true,
    countries: [],
    assignments: [
      {
        id: 'mentice-pmo',
        title: 'Director, Project Management Office',
        org: 'Mentice',
        logoImage: '/images/logos/mentice.png',
        start: '2022-10',
        end: '2023-07',
        location: 'Gothenburg, Sweden',
        countries: [
          { code: 'SE', kinds: ['based', 'team'] },
          { code: 'US', kinds: ['team'] },
        ],
      },
      {
        id: 'mentice-product',
        title: 'Product Manager — Services & Strategy',
        org: 'Mentice',
        logoImage: '/images/logos/mentice.png',
        start: '2021-12',
        end: '2022-10',
        location: 'Gothenburg, Sweden',
        countries: [
          { code: 'SE', kinds: ['based'] },
          { code: 'ES', kinds: ['visits'] },
        ],
      },
      {
        id: 'mentice-pm',
        title: 'Project Manager, Medical Device Industry',
        org: 'Mentice',
        logoImage: '/images/logos/mentice.png',
        start: '2019-06',
        end: '2021-12',
        location: 'Gothenburg, Sweden',
        countries: [
          { code: 'SE', kinds: ['based', 'team'] },
          { code: 'US', kinds: ['team', 'customers'] },
          { code: 'BE', kinds: ['visits', 'customers'] },
        ],
      },
    ],
  },
  {
    id: 'knightec',
    title: 'Consultant — Quality & Management',
    org: 'Knightec',
    logo: 'KN',
    start: '2015-09',
    end: '2019-05',
    countries: [{ code: 'SE', kinds: ['based'] }],
    assignments: [
      {
        id: 'abb',
        title: 'Project Manager',
        org: 'ABB Robotics — Spot Welding Application Center',
        logoImage: '/images/logos/abb.png',
        start: '2018-10',
        end: '2019-04',
        countries: [
          { code: 'SE', kinds: ['based'] },
          { code: 'CN', kinds: ['customers'] },
        ],
      },
      {
        id: 'care-of-sweden',
        title: 'Lead Test Engineer',
        org: 'Care of Sweden AB',
        logoImage: '/images/logos/care-of-sweden.png',
        start: '2018-06',
        end: '2018-11',
        countries: [{ code: 'SE', kinds: ['based'] }],
      },
      {
        id: 'fresenius',
        title: 'Validation Engineer',
        org: 'Fresenius Kabi',
        logoImage: '/images/logos/fresenius-kabi.jpg',
        start: '2018-05',
        end: '2018-05',
        countries: [{ code: 'NO', kinds: ['based'] }],
      },
      {
        id: 'az-pm',
        title: 'Project Manager',
        org: 'AstraZeneca — Sweden Operations',
        logoImage: '/images/logos/astrazeneca.png',
        start: '2016-01',
        end: '2018-03',
        countries: [{ code: 'SE', kinds: ['based'] }],
      },
    ],
  },
];

// Experience at a glance: whole years per category. Overlapping months count once.
const MENTICE = ['mentice-pmo', 'mentice-product', 'mentice-pm'];
const categoryDefs: { name: string; note?: string; roles: string[] }[] = [
  // Product Manager (mentice-product) left out: technical leadership, no team.
  { name: 'People Leadership', note: 'Project Leader · Line Manager', roles: ['az-ad', 'az-pm', 'abb', 'mentice-pm', 'mentice-pmo'] },
  { name: 'Line Management', note: 'Director, Mentice · Associate Director, AstraZeneca', roles: ['az-ad', 'mentice-pmo'] },
  { name: 'Project Management', note: 'Project Manager · Director PMO', roles: ['az-pm', 'abb', 'mentice-pm', 'mentice-pmo'] },
  { name: 'Software & Data', note: 'Simulation Software · Quality IT Systems · Data & AI', roles: ['az-ad', ...MENTICE] },
  { name: 'Life Sciences', note: 'Pharmaceuticals · Medical Devices · Medical Simulation', roles: ['az-ad', 'az-pm', 'fresenius', 'care-of-sweden', ...MENTICE] },
];

// Periods behind a duration, for the client script that keeps ongoing
// durations current between deploys. Only set when something is ongoing.
const livePeriods = (periods: Period[]) =>
  periods.some((p) => !p.end) ? JSON.stringify(periods.map(({ start, end }) => ({ start, end }))) : undefined;

const allRoles = experience.flatMap((r) => [r, ...(r.assignments ?? [])]);

const roleById = new Map(allRoles.map((r) => [r.id, r]));

const categories = categoryDefs.map((c) => {
  const roles = c.roles.map((id) => roleById.get(id)!);
  return { name: c.name, note: c.note, years: formatYears(monthsCovered(roles)), periods: livePeriods(roles) };
});

// Every country across all roles, with the union of involvements.
const countryKinds = new Map<CountryCode, Set<Involvement>>();
for (const c of allRoles.flatMap((r) => r.countries)) {
  if (!countryKinds.has(c.code)) countryKinds.set(c.code, new Set());
  c.kinds.forEach((k) => countryKinds.get(c.code)!.add(k));
}
const allCountries = [...countryKinds].map(([code, kinds]) => ({ code, kinds: [...kinds] }));
const education = [
  {
    degree: "Master's, Industrial Management — Management and Economics of Innovation",
    school: 'Chalmers University of Technology',
    logoImage: '/images/logos/chalmers.jpg',
    period: '2013 – 2015',
  },
  {
    degree: 'Occupational and Organisational Psychology',
    school: 'University of Gothenburg',
    logoImage: '/images/logos/university-of-gothenburg.png',
    period: '2014 – 2015',
  },
  {
    degree: "Bachelor's, Mechanical Engineering",
    school: 'Chalmers University of Technology',
    logoImage: '/images/logos/chalmers.jpg',
    period: '2010 – 2013',
  },
];

const recognition = [
  {
    title: 'Nova 111 List · Healthcare & Life Sciences · 2026',
    description: 'Selected as a top young professional talent under 35 in Sweden',
    logoImage: '/images/logos/nova-talent.png',
    period: '2026',
    href: 'https://novatalent.com/111-list/the-nova-111-list-sweden-2026',
  },
];
---
<Layout title="CV" description="Professional CV of Oskar Lindvall.">
  <p class="back"><a href="/about">← About</a></p>
  <h1>CV</h1>
  <p class="lede">Curious leader across technology and life sciences, with a background in engineering, product and projects – now focused on software and data.</p>

  <section>
    <h2>Experience</h2>
    <ul class="entry-list">
      {experience.map((job) => (
        <li class="entry-row">
          {job.logoImage ? (
            <img class="logo logo-img" src={job.logoImage} alt={`${job.org} logo`} width="32" height="32" />
          ) : (
            <div class="logo" aria-hidden="true">{job.logo}</div>
          )}
          <div class="entry-body">
            <div class="entry-title">
              {job.title}
              {job.current && <span class="badge">Current</span>}
            </div>
            <div class="entry-meta">{job.org !== job.title && <>{job.org} · </>}<span class="nowrap">{formatPeriod(job)}</span> · <span class="nowrap" data-periods={livePeriods([job])}>{formatDuration(monthsIn(job))}</span>{job.location && <> · <span class="nowrap">{job.location}</span></>}</div>
            {job.countries.length > 0 && (
              <div class="flags">
                {job.countries.map((c) => <CountryTag code={c.code} kinds={c.kinds} />)}
              </div>
            )}
            {job.assignments && job.progression && (
              <ol class="sub-list timeline">
                {job.assignments.map((a) => (
                  <li>
                    <div class="entry-title entry-title-sub">{a.title}</div>
                    <div class="entry-meta"><span class="nowrap">{formatPeriod(a)}</span> · <span class="nowrap" data-periods={livePeriods([a])}>{formatDuration(monthsIn(a))}</span></div>
                    <div class="flags">
                      {a.countries.map((c) => <CountryTag code={c.code} kinds={c.kinds} />)}
                    </div>
                  </li>
                ))}
              </ol>
            )}
            {job.assignments && !job.progression && (
              <ul class="sub-list">
                {job.assignments.map((a) => (
                  <li class="entry-row">
                    {a.logoImage ? (
                      <img class="logo logo-sub logo-img" src={a.logoImage} alt={`${a.org} logo`} width="26" height="26" />
                    ) : (
                      <div class="logo logo-sub" aria-hidden="true">{a.logo}</div>
                    )}
                    <div class="entry-body">
                      <div class="entry-title entry-title-sub">{a.title}</div>
                      <div class="entry-meta">{a.org} · <span class="nowrap">{formatPeriod(a)}</span> · <span class="nowrap" data-periods={livePeriods([a])}>{formatDuration(monthsIn(a))}</span>{a.location && <> · <span class="nowrap">{a.location}</span></>}</div>
                      <div class="flags">
                        {a.countries.map((c) => <CountryTag code={c.code} kinds={c.kinds} />)}
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Education</h2>
    <ul class="entry-list">
      {education.map((item) => (
        <li class="entry-row">
          {item.logoImage ? (
            <img class="logo logo-img" src={item.logoImage} alt={`${item.school} logo`} width="32" height="32" />
          ) : (
            <div class="logo" aria-hidden="true">{item.school.slice(0, 2).toUpperCase()}</div>
          )}
          <div class="entry-body">
            <div class="entry-title">{item.degree}</div>
            <div class="entry-meta">{item.school} · {item.period}</div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Recognition</h2>
    <ul class="entry-list">
      {recognition.map((item) => (
        <li class="entry-row">
          {item.logoImage ? (
            <img class="logo logo-img" src={item.logoImage} alt={`${item.title} logo`} width="32" height="32" />
          ) : (
            <div class="logo" aria-hidden="true">{item.title.slice(0, 2).toUpperCase()}</div>
          )}
          <div class="entry-body">
            <div class="entry-title">
              {item.href ? (
                <a href={item.href} target="_blank" rel="noopener noreferrer">{item.title}</a>
              ) : item.title}
            </div>
            <div class="entry-meta">{item.description}</div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Experience at a glance</h2>
    <ul class="entry-list summary-list">
      {categories.map((c) => (
        <li>
          <div class="summary-row">
            <span class="entry-title">{c.name}</span>
            <span class="summary-duration" data-periods={c.periods} data-format="years">{c.years}</span>
          </div>
          {c.note && <div class="summary-note">{c.note}</div>}
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>International experience</h2>
    <ul class="country-list">
      {allCountries.map((c) => (
        <li><CountryTag code={c.code} kinds={c.kinds} showName /></li>
      ))}
    </ul>
    <ul class="legend">
      {INVOLVEMENTS.map((k) => (
        <li><InvolvementIcon kind={k} /> {INVOLVEMENT_LABELS[k]}</li>
      ))}
    </ul>
  </section>

  <p class="more">Full details on <a href="https://www.linkedin.com/in/oskar-lindvall-35735854/" target="_blank" rel="noopener noreferrer">LinkedIn</a>.</p>
</Layout>

<script>
  // Recompute durations that include an ongoing role, so they stay current
  // without a redeploy. The build-time text is the no-JS fallback.
  import { formatDuration, formatYears, monthsCovered } from '../../lib/cv-duration';

  document.querySelectorAll<HTMLElement>('[data-periods]').forEach((el) => {
    try {
      const months = monthsCovered(JSON.parse(el.dataset.periods!));
      el.textContent = el.dataset.format === 'years' ? formatYears(months) : formatDuration(months);
    } catch {
      /* keep build-time value */
    }
  });
</script>

<style>
  .back {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
  }

  .back a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--color-text);
  }

  section {
    margin-top: 2.5rem;
  }

  .entry-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .entry-list > li {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .entry-list > li:last-child {
    border-bottom: none;
  }

  .entry-row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .entry-body {
    flex: 1;
    min-width: 0;
  }

  .logo {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .logo-sub {
    width: 1.6rem;
    height: 1.6rem;
    font-size: 0.6rem;
  }

  .logo.logo-img {
    box-sizing: border-box;
    border-radius: 0.4rem;
    padding: 0.3rem;
    background: #fff;
    object-fit: contain;
  }

  .logo-sub.logo-img {
    padding: 0.2rem;
  }

  .entry-title {
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .entry-meta {
    margin-top: 0.15rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .badge {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    padding: 0.05rem 0.4rem;
  }

  .sub-list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0 0 0 1.25rem;
    border-left: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .lede {
    margin: 0.5rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* Promotions within one company: dots on the line, newest highlighted. */
  .timeline li {
    position: relative;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: calc(-1.25rem - 4.5px);
    top: 0.45rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 1px solid var(--color-accent);
  }

  .timeline li:first-child::before {
    background: var(--color-accent);
  }

  .summary-note {
    margin-top: 0.15rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    opacity: 0.8;
  }

  .entry-title-sub {
    font-weight: 500;
    font-size: 0.95rem;
  }

  .nowrap {
    white-space: nowrap;
  }

  .flags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    margin-top: 0.4rem;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .summary-duration {
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }

  .country-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
  }

  .country-list li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .legend {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .more {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
