---
import Layout from '../../layouts/Layout.astro';
import Flag from '../../components/Flag.astro';
import { formatDuration, formatPeriod, monthsCovered, monthsIn, type Period } from '../../lib/cv-duration';
import { COUNTRY_NAMES, type CountryCode } from '../../lib/countries';

interface RoleCountry {
  code: CountryCode;
  note: string;
}

interface Role extends Period {
  id: string;
  title: string;
  org: string;
  logo?: string;
  logoImage?: string;
  location?: string;
  current?: boolean;
  countries: RoleCountry[];
  assignments?: Role[];
}


// Dates are 'YYYY-MM', inclusive. Omit `end` for an ongoing role.
// `countries`: where the role's team members, customers or travel were.
const experience: Role[] = [
  {
    id: 'az-ad',
    title: 'Associate Director Development Quality — Quality Systems',
    org: 'AstraZeneca',
    logoImage: '/images/logos/astrazeneca.png',
    start: '2023-07',
    location: 'Mölndal',
    current: true,
    countries: [
      { code: 'SE', note: 'team members' },
      { code: 'GB', note: 'team members' },
    ],
  },
  {
    id: 'mentice-pmo',
    title: 'Director, Project Management Office',
    org: 'Mentice',
    logoImage: '/images/logos/mentice.png',
    start: '2022-10',
    end: '2023-07',
    location: 'Gothenburg, Sweden',
    countries: [
      { code: 'SE', note: 'team members' },
      { code: 'US', note: 'team members' },
    ],
  },
  {
    id: 'mentice-product',
    title: 'Product Manager — Services & Strategy',
    org: 'Mentice',
    logoImage: '/images/logos/mentice.png',
    start: '2021-12',
    end: '2022-10',
    location: 'Gothenburg, Sweden',
    countries: [
      { code: 'SE', note: 'based' },
      { code: 'ES', note: 'visits' },
    ],
  },
  {
    id: 'mentice-pm',
    title: 'Project Manager, Medical Device Industry',
    org: 'Mentice',
    logoImage: '/images/logos/mentice.png',
    start: '2019-06',
    end: '2021-12',
    location: 'Gothenburg, Sweden',
    countries: [
      { code: 'SE', note: 'team members' },
      { code: 'US', note: 'team members, customers' },
      { code: 'BE', note: 'customers, trips' },
    ],
  },
  {
    id: 'knightec',
    title: 'Consultant — Quality & Management',
    org: 'Knightec',
    logo: 'KN',
    start: '2015-09',
    end: '2019-05',
    countries: [{ code: 'SE', note: 'based' }],
    assignments: [
      {
        id: 'abb',
        title: 'Project Manager',
        org: 'ABB Robotics — Spot Welding Application Center',
        logoImage: '/images/logos/abb.png',
        start: '2018-10',
        end: '2019-04',
        countries: [
          { code: 'SE', note: 'based' },
          { code: 'CN', note: 'customer' },
        ],
      },
      {
        id: 'care-of-sweden',
        title: 'Lead Test Engineer',
        org: 'Care of Sweden AB',
        logoImage: '/images/logos/care-of-sweden.png',
        start: '2018-06',
        end: '2018-11',
        countries: [{ code: 'SE', note: 'based' }],
      },
      {
        id: 'fresenius',
        title: 'Validation Engineer',
        org: 'Fresenius Kabi',
        logoImage: '/images/logos/fresenius-kabi.jpg',
        start: '2018-05',
        end: '2018-05',
        countries: [{ code: 'NO', note: 'based' }],
      },
      {
        id: 'az-pm',
        title: 'Project Manager',
        org: 'AstraZeneca — Sweden Operations',
        logoImage: '/images/logos/astrazeneca.png',
        start: '2016-01',
        end: '2018-03',
        countries: [{ code: 'SE', note: 'based' }],
      },
    ],
  },
];

// Accumulated experience per category. Overlapping months are counted once.
const categoryDefs: { name: string; roles: string[] }[] = [
  { name: 'Line Manager', roles: ['az-ad', 'mentice-pmo'] },
  { name: 'Team Leadership', roles: ['az-ad', 'az-pm', 'abb', 'mentice-pmo', 'mentice-product', 'mentice-pm'] },
  { name: 'Pharma Industry', roles: ['az-ad', 'az-pm', 'fresenius'] },
  { name: 'Medical Device Industry', roles: ['care-of-sweden', 'mentice-pmo', 'mentice-product', 'mentice-pm'] },
  { name: 'IT / Data Science / Robotics', roles: ['abb', 'mentice-pmo', 'mentice-product', 'mentice-pm', 'az-ad'] },
];

const allRoles = experience.flatMap((r) => [r, ...(r.assignments ?? [])]);
const roleById = new Map(allRoles.map((r) => [r.id, r]));

const categories = categoryDefs.map((c) => {
  const roles = c.roles.map((id) => roleById.get(id)!);
  const orgs = [...new Set(roles.map((r) => r.org.split(' — ')[0]))];
  return { name: c.name, duration: formatDuration(monthsCovered(roles)), orgs };
});

const allCountries = [...new Set(allRoles.flatMap((r) => r.countries.map((c) => c.code)))];

const flagTitle = (c: RoleCountry) => `${COUNTRY_NAMES[c.code]} — ${c.note}`;
// Org names can be long and may wrap; the other parts stay on one line each.
const roleMeta = (r: Role) =>
  [formatPeriod(r), formatDuration(monthsIn(r)), r.location]
    .filter(Boolean) as string[];

const education = [
  {
    degree: "Master's, Industrial Management — Management and Economics of Innovation",
    school: 'Chalmers University of Technology',
    logoImage: '/images/logos/chalmers.jpg',
    period: '2013 – 2015',
  },
  {
    degree: 'Occupational and Organisational Psychology',
    school: 'University of Gothenburg',
    logoImage: '/images/logos/university-of-gothenburg.png',
    period: '2014 – 2015',
  },
  {
    degree: "Bachelor's, Mechanical Engineering",
    school: 'Chalmers University of Technology',
    logoImage: '/images/logos/chalmers.jpg',
    period: '2010 – 2013',
  },
];

const other = [
  {
    title: 'Nova 111 List — Healthcare & Life Sciences',
    description: 'Selected as a top young professional talent in Sweden.',
    logoImage: '/images/logos/nova-talent.png',
    period: '2026',
    href: 'https://novatalent.com/111-list/the-nova-111-list-sweden-2026',
  },
];
---
<Layout title="CV" description="Professional CV of Oskar Lindvall.">
  <p class="back"><a href="/about">← About</a></p>
  <h1>CV</h1>

  <section>
    <h2>Experience</h2>
    <ul class="entry-list">
      {experience.map((job) => (
        <li class="entry-row">
          {job.logoImage ? (
            <img class="logo logo-img" src={job.logoImage} alt={`${job.org} logo`} width="32" height="32" />
          ) : (
            <div class="logo" aria-hidden="true">{job.logo}</div>
          )}
          <div class="entry-body">
            <div class="entry-title">
              {job.title}
              {job.current && <span class="badge">Current</span>}
            </div>
            <div class="entry-meta">{job.org}{roleMeta(job).map((part) => <> · <span class="nowrap">{part}</span></>)}</div>
            <div class="flags">
              {job.countries.map((c) => <Flag code={c.code} title={flagTitle(c)} />)}
            </div>
            {job.assignments && (
              <ul class="sub-list">
                {job.assignments.map((a) => (
                  <li class="entry-row">
                    {a.logoImage ? (
                      <img class="logo logo-sub logo-img" src={a.logoImage} alt={`${a.org} logo`} width="26" height="26" />
                    ) : (
                      <div class="logo logo-sub" aria-hidden="true">{a.logo}</div>
                    )}
                    <div class="entry-body">
                      <div class="entry-title entry-title-sub">{a.title}</div>
                      <div class="entry-meta">{a.org}{roleMeta(a).map((part) => <> · <span class="nowrap">{part}</span></>)}</div>
                      <div class="flags">
                        {a.countries.map((c) => <Flag code={c.code} title={flagTitle(c)} />)}
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Education</h2>
    <ul class="entry-list">
      {education.map((item) => (
        <li class="entry-row">
          {item.logoImage ? (
            <img class="logo logo-img" src={item.logoImage} alt={`${item.school} logo`} width="32" height="32" />
          ) : (
            <div class="logo" aria-hidden="true">{item.school.slice(0, 2).toUpperCase()}</div>
          )}
          <div class="entry-body">
            <div class="entry-title">{item.degree}</div>
            <div class="entry-meta">{item.school} · {item.period}</div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Other</h2>
    <ul class="entry-list">
      {other.map((item) => (
        <li class="entry-row">
          {item.logoImage ? (
            <img class="logo logo-img" src={item.logoImage} alt={`${item.title} logo`} width="32" height="32" />
          ) : (
            <div class="logo" aria-hidden="true">{item.title.slice(0, 2).toUpperCase()}</div>
          )}
          <div class="entry-body">
            <div class="entry-title">
              {item.href ? (
                <a href={item.href} target="_blank" rel="noopener noreferrer">{item.title}</a>
              ) : item.title}
            </div>
            <div class="entry-meta">{item.description} · {item.period}</div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Accumulated experience</h2>
    <ul class="entry-list summary-list">
      {categories.map((c) => (
        <li>
          <div class="summary-row">
            <span class="entry-title">{c.name}</span>
            <span class="summary-duration">{c.duration}</span>
          </div>
          <div class="entry-meta">{c.orgs.join(' · ')}</div>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>International experience</h2>
    <ul class="country-list">
      {allCountries.map((code) => (
        <li>
          <Flag code={code} />
          <span>{COUNTRY_NAMES[code]}</span>
        </li>
      ))}
    </ul>
  </section>

  <p class="more">Full details on <a href="https://www.linkedin.com/in/oskar-lindvall-35735854/" target="_blank" rel="noopener noreferrer">LinkedIn</a>.</p>
</Layout>

<style>
  .back {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
  }

  .back a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--color-text);
  }

  section {
    margin-top: 2.5rem;
  }

  .entry-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .entry-list > li {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .entry-list > li:last-child {
    border-bottom: none;
  }

  .entry-row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .entry-body {
    flex: 1;
    min-width: 0;
  }

  .logo {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .logo-sub {
    width: 1.6rem;
    height: 1.6rem;
    font-size: 0.6rem;
  }

  .logo.logo-img {
    box-sizing: border-box;
    border-radius: 0.4rem;
    padding: 0.3rem;
    background: #fff;
    object-fit: contain;
  }

  .logo-sub.logo-img {
    padding: 0.2rem;
  }

  .entry-title {
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .entry-meta {
    margin-top: 0.15rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .badge {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    padding: 0.05rem 0.4rem;
  }

  .sub-list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0 0 0 1.25rem;
    border-left: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .entry-title-sub {
    font-weight: 500;
    font-size: 0.95rem;
  }

  .nowrap {
    white-space: nowrap;
  }

  .flags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.4rem;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .summary-duration {
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }

  .country-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
  }

  .country-list li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .more {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
