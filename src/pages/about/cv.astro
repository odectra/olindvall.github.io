---
import Layout from '../../layouts/Layout.astro';
import CountryTag from '../../components/CountryTag.astro';
import InvolvementIcon from '../../components/InvolvementIcon.astro';
import { formatDuration, formatPeriod, formatYears, monthsCovered, monthsIn, type Period } from '../../lib/cv-duration';
import { INVOLVEMENTS, INVOLVEMENT_SHORT, type CountryCode, type Involvement } from '../../lib/countries';

interface RoleCountry {
  code: CountryCode;
  kinds: Involvement[];
}

interface Role extends Period {
  id: string;
  title: string;
  org: string;
  logo?: string;
  logoImage?: string;
  location?: string;
  current?: boolean;
  countries: RoleCountry[];
  // One short sentence, shown only when the "Details" toggle is on.
  summary?: string;
  // Client assignments (Knightec) or, with `progression`, promotions within one company.
  assignments?: Role[];
  progression?: boolean;
}


// Dates are 'YYYY-MM', inclusive. Omit `end` for an ongoing role.
// `countries`: where the role was based, led team members, visited clients or had customers.
const experience: Role[] = [
  {
    id: 'az-ad',
    summary: "Lead a team of 4-6 members in Sweden and the UK supporting AstraZeneca's quality IT systems, and drive data, AI and digital improvement projects. Awarded as Exceptional Contributor (EC) in 2024 performance review.",
    title: 'Associate Director Development Quality — Quality Systems',
    org: 'AstraZeneca',
    logoImage: '/images/logos/astrazeneca.png',
    start: '2023-07',
    location: 'Mölndal',
    current: true,
    countries: [
      { code: 'SE', kinds: ['based', 'team'] },
      { code: 'GB', kinds: ['team'] },
    ],
  },
  {
    id: 'mentice',
    summary: "Promoted from project manager to product manager to head of the project management office.",
    title: 'Mentice',
    org: 'Mentice',
    logoImage: '/images/logos/mentice.png',
    start: '2019-06',
    end: '2023-07',
    location: 'Gothenburg, Sweden',
    progression: true,
    countries: [],
    assignments: [
      {
        id: 'mentice-pmo',
        summary: "Led the project management office, with seven project managers in Sweden and the USA.",
        title: 'Director, Project Management Office',
        org: 'Mentice',
        logoImage: '/images/logos/mentice.png',
        start: '2022-10',
        end: '2023-07',
        location: 'Gothenburg, Sweden',
        countries: [
          { code: 'SE', kinds: ['based', 'team'] },
          { code: 'US', kinds: ['team'] },
        ],
      },
      {
        id: 'mentice-product',
        summary: "Technical product manager for services and strategy: owned the service offering, took part in an M&A due-diligence trip to Barcelona, and built a product and SaaS business-case model (DCF, IRR, payback).",
        title: 'Product Manager — Services & Strategy',
        org: 'Mentice',
        logoImage: '/images/logos/mentice.png',
        start: '2021-12',
        end: '2022-10',
        location: 'Gothenburg, Sweden',
        countries: [
          { code: 'SE', kinds: ['based'] },
          { code: 'ES', kinds: ['visits'] },
        ],
      },
      {
        id: 'mentice-pm',
        summary: "Ran medical simulation projects in cardiac rhythm management, electrophysiology and acute ischemic stroke for medical device clients such as Abbott, Biotronik and Stryker.",
        title: 'Project Manager, Medical Device Industry',
        org: 'Mentice',
        logoImage: '/images/logos/mentice.png',
        start: '2019-06',
        end: '2021-12',
        location: 'Gothenburg, Sweden',
        countries: [
          { code: 'SE', kinds: ['based', 'team'] },
          { code: 'US', kinds: ['team', 'customers'] },
          { code: 'BE', kinds: ['visits', 'customers'] },
        ],
      },
    ],
  },
  {
    id: 'knightec',
    summary: "Consultant on quality and project assignments across pharma, medical devices and robotics.",
    title: 'Consultant — Quality & Management',
    org: 'Knightec',
    logo: 'KN',
    start: '2015-09',
    end: '2019-05',
    countries: [{ code: 'SE', kinds: ['based'] }],
    assignments: [
      {
        id: 'abb',
        summary: "Project lead for spot welding projects for an automotive customer in China.",
        title: 'Project Manager',
        org: 'ABB Robotics — Spot Welding Application Center',
        logoImage: '/images/logos/abb.png',
        start: '2018-10',
        end: '2019-04',
        countries: [
          { code: 'SE', kinds: ['based'] },
          { code: 'CN', kinds: ['customers'] },
        ],
      },
      {
        id: 'care-of-sweden',
        summary: "Led testing of a medical device for preventing pressure ulcers.",
        title: 'Lead Test Engineer',
        org: 'Care of Sweden AB',
        logoImage: '/images/logos/care-of-sweden.png',
        start: '2018-06',
        end: '2018-11',
        countries: [{ code: 'SE', kinds: ['based'] }],
      },
      {
        id: 'fresenius',
        summary: "Validation engineering assignment, based at a site in Norway.",
        title: 'Validation Engineer',
        org: 'Fresenius Kabi',
        logoImage: '/images/logos/fresenius-kabi.jpg',
        start: '2018-05',
        end: '2018-05',
        countries: [{ code: 'NO', kinds: ['based'] }],
      },
      {
        id: 'az-pm',
        summary: "Project manager in AstraZeneca's Sweden Operations, part of projects establishing manufacturing for Genuair (COPD) and Lynparza (oncology).",
        title: 'Project Manager',
        org: 'AstraZeneca — Sweden Operations',
        logoImage: '/images/logos/astrazeneca.png',
        start: '2016-01',
        end: '2018-03',
        countries: [{ code: 'SE', kinds: ['based'] }],
      },
    ],
  },
];

// Experience at a glance: whole years per category. Overlapping months count once.
const MENTICE = ['mentice-pmo', 'mentice-product', 'mentice-pm'];
const categoryDefs: { name: string; note?: string; roles: string[] }[] = [
  // Product Manager (mentice-product) left out: technical leadership, no team.
  { name: 'People Leadership', note: 'Project Leader · Line Manager', roles: ['az-ad', 'az-pm', 'abb', 'mentice-pm', 'mentice-pmo'] },
  { name: 'Line Management', note: 'Director, Mentice · Associate Director, AstraZeneca', roles: ['az-ad', 'mentice-pmo'] },
  { name: 'Project Management', note: 'Project Manager · Director PMO', roles: ['az-pm', 'abb', 'mentice-pm', 'mentice-pmo'] },
  { name: 'Software & Data', note: 'Simulation Software · Quality IT Systems · Data & AI', roles: ['az-ad', ...MENTICE] },
  { name: 'Life Sciences', note: 'Pharmaceuticals · Medical Devices · Medical Simulation', roles: ['az-ad', 'az-pm', 'fresenius', 'care-of-sweden', ...MENTICE] },
];

// Periods behind a duration, for the client script that keeps ongoing
// durations current between deploys. Only set when something is ongoing.
const livePeriods = (periods: Period[]) =>
  periods.some((p) => !p.end) ? JSON.stringify(periods.map(({ start, end }) => ({ start, end }))) : undefined;

const allRoles = experience.flatMap((r) => [r, ...(r.assignments ?? [])]);

const roleById = new Map(allRoles.map((r) => [r.id, r]));

// Bars show each category's share of the whole career (first role to today).
const careerStart = allRoles.map((r) => r.start).sort()[0];
const careerMonths = monthsIn({ start: careerStart });

const categories = categoryDefs.map((c) => {
  const roles = c.roles.map((id) => roleById.get(id)!);
  const months = monthsCovered(roles);
  return {
    name: c.name,
    note: c.note,
    years: formatYears(months),
    share: `${((months / careerMonths) * 100).toFixed(1)}%`,
    periods: livePeriods(roles),
  };
});

interface Course {
  title: string;
  meta: string[];
}

interface Education {
  degree: string;
  school: string;
  pace?: string;
  logoImage?: string;
  period: string;
  courses?: Course[];
}

const education: Education[] = [
  {
    degree: "Master's, Industrial Management — Management and Economics of Innovation",
    school: 'Chalmers University of Technology',
    pace: 'Full-time',
    logoImage: '/images/logos/chalmers.jpg',
    period: '2013 – 2015',
  },
  {
    degree: 'Courses in psychology and law',
    school: 'University of Gothenburg',
    logoImage: '/images/logos/university-of-gothenburg.png',
    period: '2014 – 2015',
    courses: [
      {
        title: 'Occupational and Organisational Psychology',
        meta: ['Department of Psychology', '30 credits, half-time', 'Sep 2014 – May 2015'],
      },
      {
        title: 'Introduction to Law',
        meta: ['Department of Law', '15 credits', 'Autumn 2014'],
      },
    ],
  },
  {
    degree: "Bachelor's, Mechanical Engineering",
    school: 'Chalmers University of Technology',
    pace: 'Full-time',
    logoImage: '/images/logos/chalmers.jpg',
    period: '2010 – 2013',
  },
];

const recognition = [
  {
    title: 'Nova 111 List · Healthcare & Life Sciences · 2026',
    description: 'Selected as a top young professional talent under 35 in Sweden',
    logoImage: '/images/logos/nova-talent.png',
    period: '2026',
    href: 'https://novatalent.com/111-list/the-nova-111-list-sweden-2026',
  },
];
---
<Layout title="CV" description="Professional CV of Oskar Lindvall.">
  <p class="back"><a href="/about">← About</a></p>
  <h1>CV</h1>
  <p class="lede">Engineer leading people across technology and life sciences, increasingly drawn to where software, data, health and human performance meet.</p>

  <section>
    <div class="section-head">
      <h2>Experience</h2>
      <label class="details-toggle">
        <input type="checkbox" id="show-details" />
        <span class="switch" aria-hidden="true"></span>
        Details
      </label>
    </div>
    <ul class="legend" aria-label="Icons next to flags">
      {INVOLVEMENTS.map((k) => (
        <li><InvolvementIcon kind={k} /> {INVOLVEMENT_SHORT[k]}</li>
      ))}
    </ul>
    <ul class="entry-list">
      {experience.map((job) => (
        <li class="entry-row">
          {job.logoImage ? (
            <img class="logo logo-img" src={job.logoImage} alt={`${job.org} logo`} width="32" height="32" />
          ) : (
            <div class="logo" aria-hidden="true">{job.logo}</div>
          )}
          <div class="entry-body">
            <div class="entry-title">
              {job.title}
              {job.current && <span class="badge">Current</span>}
            </div>
            <div class="entry-meta">{job.org !== job.title && <>{job.org} · </>}<span class="nowrap">{formatPeriod(job)}</span> · <span class="nowrap" data-periods={livePeriods([job])}>{formatDuration(monthsIn(job))}</span>{job.location && <> · <span class="nowrap">{job.location}</span></>}</div>
            {job.summary && <p class="role-detail">{job.summary}</p>}
            {job.countries.length > 0 && (
              <div class="flags">
                {job.countries.map((c) => <CountryTag code={c.code} kinds={c.kinds} />)}
              </div>
            )}
            {job.assignments && job.progression && (
              <ol class="sub-list timeline">
                {job.assignments.map((a) => (
                  <li>
                    <div class="entry-title entry-title-sub">{a.title}</div>
                    <div class="entry-meta"><span class="nowrap">{formatPeriod(a)}</span> · <span class="nowrap" data-periods={livePeriods([a])}>{formatDuration(monthsIn(a))}</span></div>
                    {a.summary && <p class="role-detail">{a.summary}</p>}
                    <div class="flags">
                      {a.countries.map((c) => <CountryTag code={c.code} kinds={c.kinds} />)}
                    </div>
                  </li>
                ))}
              </ol>
            )}
            {job.assignments && !job.progression && (
              <ul class="sub-list">
                {job.assignments.map((a) => (
                  <li class="entry-row">
                    {a.logoImage ? (
                      <img class="logo logo-sub logo-img" src={a.logoImage} alt={`${a.org} logo`} width="26" height="26" />
                    ) : (
                      <div class="logo logo-sub" aria-hidden="true">{a.logo}</div>
                    )}
                    <div class="entry-body">
                      <div class="entry-title entry-title-sub">{a.title}</div>
                      <div class="entry-meta">{a.org} · <span class="nowrap">{formatPeriod(a)}</span> · <span class="nowrap" data-periods={livePeriods([a])}>{formatDuration(monthsIn(a))}</span>{a.location && <> · <span class="nowrap">{a.location}</span></>}</div>
                      {a.summary && <p class="role-detail">{a.summary}</p>}
                      <div class="flags">
                        {a.countries.map((c) => <CountryTag code={c.code} kinds={c.kinds} />)}
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Education</h2>
    <ul class="entry-list">
      {education.map((item) => (
        <li class="entry-row">
          {item.logoImage ? (
            <img class="logo logo-img" src={item.logoImage} alt={`${item.school} logo`} width="32" height="32" />
          ) : (
            <div class="logo" aria-hidden="true">{item.school.slice(0, 2).toUpperCase()}</div>
          )}
          <div class="entry-body">
            <div class="entry-title">{item.degree}</div>
            <div class="entry-meta">{item.school} · <span class="nowrap">{item.period}</span>{item.pace && <> · {item.pace}</>}</div>
            {item.courses && (
              <ul class="sub-list">
                {item.courses.map((c) => (
                  <li>
                    <div class="entry-title entry-title-sub">{c.title}</div>
                    <div class="entry-meta">{c.meta.map((part, i) => <>{i > 0 && ' · '}<span class="nowrap">{part}</span></>)}</div>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Recognition</h2>
    <ul class="entry-list">
      {recognition.map((item) => (
        <li class="entry-row">
          {item.logoImage ? (
            <img class="logo logo-img" src={item.logoImage} alt={`${item.title} logo`} width="32" height="32" />
          ) : (
            <div class="logo" aria-hidden="true">{item.title.slice(0, 2).toUpperCase()}</div>
          )}
          <div class="entry-body">
            <div class="entry-title">
              {item.href ? (
                <a href={item.href} target="_blank" rel="noopener noreferrer">{item.title}</a>
              ) : item.title}
            </div>
            <div class="entry-meta">{item.description}</div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Experience at a glance</h2>
    <dl class="glance">
      {categories.map((c) => (
        <div class="glance-row">
          <dt>{c.name}</dt>
          <dd class="glance-years" data-periods={c.periods} data-format="years">{c.years}</dd>
          <dd class="glance-bar" aria-hidden="true">
            <span style={`width: ${c.share}`} data-periods={c.periods} data-format="share" data-career-start={careerStart}></span>
          </dd>
          {c.note && <dd class="glance-note">{c.note}</dd>}
        </div>
      ))}
    </dl>
    <p class="glance-scale">Bars show share of career since {careerStart.slice(0, 4)} · <span data-periods={livePeriods([{ start: careerStart }])} data-format="years">{formatYears(careerMonths)}</span></p>
  </section>

  <p class="more">Full details on <a href="https://www.linkedin.com/in/oskar-lindvall-35735854/" target="_blank" rel="noopener noreferrer">LinkedIn</a>.</p>
</Layout>

<script>
  // Recompute durations that include an ongoing role, so they stay current
  // without a redeploy. The build-time text is the no-JS fallback.
  import { formatDuration, formatYears, monthsCovered } from '../../lib/cv-duration';

  document.querySelectorAll<HTMLElement>('[data-periods]').forEach((el) => {
    try {
      const months = monthsCovered(JSON.parse(el.dataset.periods!));
      if (el.dataset.format === 'share') {
        const career = monthsCovered([{ start: el.dataset.careerStart! }]);
        el.style.width = `${((months / career) * 100).toFixed(1)}%`;
      } else {
        el.textContent = el.dataset.format === 'years' ? formatYears(months) : formatDuration(months);
      }
    } catch {
      /* keep build-time value */
    }
  });
</script>

<style>
  .back {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
  }

  .back a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--color-text);
  }

  section {
    margin-top: 2.5rem;
  }

  .entry-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .entry-list > li {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .entry-list > li:last-child {
    border-bottom: none;
  }

  .entry-row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .entry-body {
    flex: 1;
    min-width: 0;
  }

  .logo {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .logo-sub {
    width: 1.6rem;
    height: 1.6rem;
    font-size: 0.6rem;
  }

  .logo.logo-img {
    box-sizing: border-box;
    border-radius: 0.4rem;
    padding: 0.3rem;
    background: #fff;
    object-fit: contain;
  }

  .logo-sub.logo-img {
    padding: 0.2rem;
  }

  .entry-title {
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .entry-meta {
    margin-top: 0.15rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .badge {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    padding: 0.05rem 0.4rem;
  }

  .sub-list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0 0 0 1.25rem;
    border-left: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .lede {
    margin: 0.5rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* Promotions within one company: dots on the line, newest highlighted. */
  .timeline li {
    position: relative;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: calc(-1.25rem - 4.5px);
    top: 0.45rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 1px solid var(--color-accent);
  }

  .timeline li:first-child::before {
    background: var(--color-accent);
  }

  .entry-title-sub {
    font-weight: 500;
    font-size: 0.95rem;
  }

  .nowrap {
    white-space: nowrap;
  }

  .flags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    margin-top: 0.4rem;
  }

  .glance {
    margin: 1rem 0 0;
  }

  .glance-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: 1rem;
    padding: 0.45rem 0;
  }

  .glance dt {
    font-weight: 600;
    font-size: 0.95rem;
    min-width: 0;
  }

  .glance dd {
    margin: 0;
  }

  .glance-years {
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-accent);
  }

  .glance-bar {
    grid-column: 1 / -1;
    height: 6px;
    margin: 0.35rem 0 0.25rem !important;
    border-radius: 3px;
    background: var(--color-border);
    overflow: hidden;
  }

  .glance-bar span {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: var(--color-accent);
  }

  .glance-note {
    grid-column: 1 / -1;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    opacity: 0.85;
  }

  .glance-scale {
    margin: 0.6rem 0 0;
    text-align: right;
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  /* Details toggle: pure CSS, off by default. */
  .details-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    cursor: pointer;
    user-select: none;
  }

  .details-toggle input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .switch {
    position: relative;
    width: 1.8rem;
    height: 1rem;
    border-radius: 999px;
    background: var(--color-border);
    transition: background 0.15s;
  }

  .switch::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: calc(1rem - 4px);
    height: calc(1rem - 4px);
    border-radius: 50%;
    background: var(--color-bg);
    transition: transform 0.15s;
  }

  .details-toggle input:checked + .switch {
    background: var(--color-accent);
  }

  .details-toggle input:checked + .switch::after {
    transform: translateX(0.8rem);
  }

  .details-toggle input:focus-visible + .switch {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .role-detail {
    display: none;
    margin: 0.3rem 0 0;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  section:has(#show-details:checked) .role-detail {
    display: block;
  }

  .legend {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .more {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
