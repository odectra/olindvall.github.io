---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const intro = await getEntry('home', 'intro');
const { Content } = await render(intro);
---
<Layout title="Home">
  <h1>{intro.data.title}</h1>
  <div class="content">
    <Content />
  </div>
</Layout>

<style>
  .content {
    margin-top: 1.5rem;
  }

  .content :global(p) {
    margin: 0 0 1.25rem;
  }
</style>
