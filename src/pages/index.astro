---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const intro = await getEntry('home', 'intro');
const { Content } = await render(intro);
---
<Layout
  title="Home"
  description="Personal site of Oskar Lindvall — Associate Director at AstraZeneca, endurance athlete, and builder of small web tools. Reflections on leadership, training, learning, and family."
>
  <h1>{intro.data.title}</h1>
  <div class="content">
    <Content />
  </div>
</Layout>

<style>
  .content {
    margin-top: 1.5rem;
  }

  .content :global(p) {
    margin: 0 0 1.25rem;
  }
</style>
