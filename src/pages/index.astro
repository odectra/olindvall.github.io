---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const intro = await getEntry('home', 'intro');
const { Content } = await render(intro);
---
<Layout
  title="Home"
  description="Personal site of Oskar Lindvall — Associate Director at AstraZeneca, endurance athlete, and builder of small web tools. Reflections on leadership, training, learning, and family."
>
  <div class="intro">
    <a href="/about" class="avatar-link" aria-label="About Oskar Lindvall">
      <img class="avatar" src="/images/about/oskar-portrait.jpg" alt="Oskar Lindvall" width="64" height="64" />
    </a>
    <h1 class="bubble">{intro.data.title}</h1>
  </div>
  <div class="content">
    <Content />
  </div>
</Layout>

<style>
  .intro {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .avatar-link {
    flex-shrink: 0;
    line-height: 0;
  }

  .avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-border);
  }

  .avatar-link:hover .avatar {
    border-color: var(--color-accent);
  }

  .bubble {
    position: relative;
    margin: 0;
    padding: 0.75rem 1.25rem;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    box-shadow: var(--shadow-card);
  }

  .bubble::before,
  .bubble::after {
    content: '';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 0;
    border-top: 0.5rem solid transparent;
    border-bottom: 0.5rem solid transparent;
  }

  .bubble::before {
    left: -0.6rem;
    border-right: 0.6rem solid var(--color-border);
  }

  .bubble::after {
    left: -0.52rem;
    border-right: 0.52rem solid var(--color-card);
  }

  .content {
    margin-top: 1.5rem;
  }

  .content :global(p) {
    margin: 0 0 1.25rem;
  }
</style>
