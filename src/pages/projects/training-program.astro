---
import Layout from '../../layouts/Layout.astro';
import { trainingSessions, weeklyHours } from '../../data/trainingProgram';

const weeks = [1, 2, 3, 4, 5];
const forms = ['Running', 'Ski erg', 'Swimming', 'Strength'] as const;
---
<Layout
  title="Base Training Program"
  description="A rolling 5-week base training program for swimrun and running — running, ski erg, swimming and strength, with a filterable list/calendar view and a weekly volume chart."
>
  <div class="training-page">
    <h1>Base Training Program</h1>
    <p class="intro">
      A rolling 5-week block that lays the base workout program for swimrun, running and general
      endurance and robustness during winter season. No taper included, since this is the base
      itself, designed to prepare me for race-specific taper periods starting typically 6-12
      weeks before individual events (swimrun, 10K, half marathon, etc.). Running with Majornas
      IK, ski erg and strength at home, swimming with TriVäst.
    </p>

    <div class="rule-box">
      <p>
        <strong>Volume rule:</strong> running should land at 40-55 km/week with 1-2 quality
        sessions. The fixed sessions (Mon, Wed, Thu, Sat) normally give 40-48 km — add the
        optional easy sessions on Friday and/or Sunday if the week needs more volume. Ski erg
        and swimming: 1-2 sessions/week each. Strength: max 3 sessions of 15-20 min/week (2
        fixed, Tue + Fri — a third can be slotted in on a free day if time allows).
      </p>
    </div>

    <div class="meta-row">
      <div class="stat">
        <span class="stat-value">5</span>
        <span class="stat-label">weeks, rolling</span>
      </div>
      <div class="stat">
        <span class="stat-value">40-55 km</span>
        <span class="stat-label">running / week</span>
      </div>
      <div class="stat">
        <span class="stat-value">1-2</span>
        <span class="stat-label">ski erg &amp; swim sessions</span>
      </div>
      <div class="stat">
        <span class="stat-value">≤3</span>
        <span class="stat-label">strength sessions</span>
      </div>
    </div>

    <div class="filters">
      <div class="filter-group">
        <span class="filter-label">Form</span>
        {forms.map((f) => (
          <button type="button" class="chip form-chip active" data-filter="form" data-value={f}>
            {f}
          </button>
        ))}
      </div>
      <div class="filter-group">
        <span class="filter-label">Week</span>
        <select id="weekSelect" class="week-select">
          <option value="all">All weeks</option>
          {weeks.map((w) => <option value={w}>Week {w}</option>)}
        </select>
        <input class="search-input" id="searchInput" type="text" placeholder="Search sessions…" />
      </div>
      <div class="filter-group">
        <span class="filter-label">View</span>
        <button type="button" class="chip active" data-filter="view" data-value="list">List</button>
        <button type="button" class="chip" data-filter="view" data-value="calendar">Calendar</button>
      </div>
    </div>

    <div id="content"></div>

    <div class="chart-section">
      <h2>Weekly training volume</h2>
      <p class="chart-caption">
        Shown in training hours per discipline. Running is converted from kilometers at a 5:00
        min/km pace. Optional filler sessions (Fri/Sun) aren't included, since they vary with
        need.
      </p>
      <div class="chart-legend">
        <span class="legend-item"><span class="legend-swatch swatch-run"></span>Running</span>
        <span class="legend-item"><span class="legend-swatch swatch-swim"></span>Swimming</span>
        <span class="legend-item"><span class="legend-swatch swatch-ski"></span>Ski erg</span>
        <span class="legend-item"><span class="legend-swatch swatch-strength"></span>Strength</span>
      </div>
      <div id="chartContainer"></div>
      <p class="chart-note" id="chartNote"></p>
    </div>

    <p class="footnote">
      The program repeats every 5 weeks — run weeks 1-5, then start over at 1. Thursday's MIK
      session is chosen on a rolling basis from the club's current schedule. Optional easy runs
      (Fri/Sun) are added as needed to reach the week's volume target.
    </p>
  </div>

  <script type="application/json" id="training-data" set:html={JSON.stringify(trainingSessions)} />
  <script type="application/json" id="weekly-hours-data" set:html={JSON.stringify(weeklyHours)} />
</Layout>

<style>
  .training-page {
    --color-form-run: var(--color-accent);
    --color-form-swim: oklch(53% 0.12 230);
    --color-form-ski: oklch(58% 0.13 90);
    --color-form-strength: oklch(48% 0.02 55);
  }

  @media (prefers-color-scheme: dark) {
    .training-page {
      --color-form-swim: oklch(72% 0.13 230);
      --color-form-ski: oklch(75% 0.14 90);
      --color-form-strength: oklch(70% 0.02 55);
    }
  }

  .intro {
    color: var(--color-text-muted);
    margin-top: 1rem;
  }

  .rule-box {
    margin: 1.5rem 0;
    padding: 1rem 1.15rem;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
    font-size: 0.9rem;
  }

  .rule-box p {
    margin: 0;
  }

  .meta-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1rem;
    margin: 1.75rem 0;
  }

  .stat {
    padding: 0.9rem 1rem;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .stat-value {
    font-family: var(--font-serif);
    font-size: 1.3rem;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .filters {
    position: sticky;
    top: 0;
    background: var(--color-bg);
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.5rem;
    z-index: 10;
  }

  .filter-group {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 0.6rem;
  }

  .filter-group:last-child {
    margin-bottom: 0;
  }

  .filter-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    width: 3.75rem;
    flex-shrink: 0;
  }

  .chip {
    font: inherit;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .chip:hover {
    border-color: var(--color-accent);
  }

  .chip.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg);
  }

  .chip.active.off {
    background: transparent;
    color: var(--color-text-muted);
    border-color: var(--color-border);
    text-decoration: line-through;
  }

  .form-chip[data-value='Running'].active { background: var(--color-form-run); border-color: var(--color-form-run); }
  .form-chip[data-value='Swimming'].active { background: var(--color-form-swim); border-color: var(--color-form-swim); }
  .form-chip[data-value='Ski erg'].active { background: var(--color-form-ski); border-color: var(--color-form-ski); }
  .form-chip[data-value='Strength'].active { background: var(--color-form-strength); border-color: var(--color-form-strength); }
  .form-chip.active { color: var(--color-bg); }
  .form-chip.active.off { background: transparent; color: var(--color-text-muted); }

  .week-select,
  .search-input {
    font: inherit;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-card);
    color: var(--color-text);
  }

  .search-input {
    width: 180px;
  }

  .week-select:focus,
  .search-input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .chart-section {
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }

  .chart-section h2 {
    margin: 0 0 0.4rem;
    font-size: 1.2rem;
  }

  .chart-caption {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    max-width: 60ch;
    margin: 0 0 1.1rem;
  }

  .chart-legend {
    display: flex;
    gap: 1.1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .legend-swatch {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    display: inline-block;
  }

  .swatch-run { background: var(--color-form-run); }
  .swatch-swim { background: var(--color-form-swim); }
  .swatch-ski { background: var(--color-form-ski); }
  .swatch-strength { background: var(--color-form-strength); }

  .chart-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: 0.6rem;
  }

  .footnote {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  #chartContainer :global(svg) {
    width: 100%;
    height: auto;
    display: block;
    font-family: var(--font-sans);
  }

  #chartContainer :global(text) {
    fill: var(--color-text-muted);
  }

  #chartContainer :global(text.chart-total) {
    fill: var(--color-text);
    font-weight: 600;
  }

  #chartContainer :global(line) {
    stroke: var(--color-border);
  }

  /* Dynamically rendered content (list / calendar views) — built via innerHTML on the
     client, so these selectors must be :global to survive Astro's style scoping. */
  :global(.week-block) {
    margin-bottom: 1.75rem;
    padding-top: 0.75rem;
    border-top: 2px solid var(--color-text);
  }

  :global(.week-head) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }

  :global(.week-title) {
    font-family: var(--font-serif);
    font-size: 1.15rem;
  }

  :global(.week-sub) {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  :global(.session) {
    display: grid;
    grid-template-columns: 2.75rem 6.5rem 1fr 7rem;
    gap: 0.75rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--color-border);
    align-items: baseline;
  }

  :global(.session:last-child) {
    border-bottom: none;
  }

  :global(.session.optional) {
    opacity: 0.7;
  }

  :global(.s-day) {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  :global(.s-form) {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  :global(.s-form-name) {
    font-size: 0.82rem;
    font-weight: 600;
  }

  :global(.s-purpose) {
    font-size: 0.7rem;
  }

  :global(.session[data-form='Running'] .s-form-name),
  :global(.session[data-form='Running'] .s-purpose) { color: var(--color-form-run); }
  :global(.session[data-form='Swimming'] .s-form-name),
  :global(.session[data-form='Swimming'] .s-purpose) { color: var(--color-form-swim); }
  :global(.session[data-form='Ski erg'] .s-form-name),
  :global(.session[data-form='Ski erg'] .s-purpose) { color: var(--color-form-ski); }
  :global(.session[data-form='Strength'] .s-form-name),
  :global(.session[data-form='Strength'] .s-purpose) { color: var(--color-form-strength); }

  :global(.s-plan) {
    font-size: 0.85rem;
  }

  :global(.opt-tag) {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    margin-left: 0.4rem;
    white-space: nowrap;
  }

  :global(.s-vol) {
    font-size: 0.78rem;
    text-align: right;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  :global(.empty-state) {
    padding: 3.5rem 0;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 560px) {
    :global(.session) {
      grid-template-columns: 2.2rem 1fr;
      grid-template-rows: auto auto auto;
    }
    :global(.s-form) { grid-column: 2; grid-row: 1; }
    :global(.s-plan) { grid-column: 2; grid-row: 2; }
    :global(.s-vol) { grid-column: 2; grid-row: 3; text-align: left; margin-top: 0.15rem; }
    :global(.s-day) { grid-row: 1 / span 3; }
    .filter-label { width: 100%; margin-bottom: 0.25rem; }
  }

  /* Calendar view */
  :global(.cal-week) {
    margin-bottom: 2rem;
    padding-top: 0.75rem;
    border-top: 2px solid var(--color-text);
  }

  :global(.cal-title) {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    margin-bottom: 0.6rem;
  }

  :global(.cal-grid) {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.4rem;
  }

  :global(.cal-day-head) {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-align: center;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  :global(.cal-day-col) {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-height: 3.5rem;
  }

  :global(.cal-pill) {
    border-radius: var(--radius);
    padding: 0.35rem 0.45rem;
    font-size: 0.68rem;
    line-height: 1.35;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-text-muted);
    color: var(--color-text);
  }

  :global(.cal-pill.optional) {
    opacity: 0.65;
    border-left-style: dashed;
  }

  :global(.cal-pill[data-form='Running']) { border-left-color: var(--color-form-run); }
  :global(.cal-pill[data-form='Swimming']) { border-left-color: var(--color-form-swim); }
  :global(.cal-pill[data-form='Ski erg']) { border-left-color: var(--color-form-ski); }
  :global(.cal-pill[data-form='Strength']) { border-left-color: var(--color-form-strength); }

  :global(.cal-pill .p-form) {
    font-weight: 600;
    font-size: 0.66rem;
    display: block;
  }

  :global(.cal-pill[data-form='Running'] .p-form) { color: var(--color-form-run); }
  :global(.cal-pill[data-form='Swimming'] .p-form) { color: var(--color-form-swim); }
  :global(.cal-pill[data-form='Ski erg'] .p-form) { color: var(--color-form-ski); }
  :global(.cal-pill[data-form='Strength'] .p-form) { color: var(--color-form-strength); }

  :global(.cal-pill .p-vol) {
    font-size: 0.63rem;
    color: var(--color-text-muted);
    display: block;
    margin-top: 0.15rem;
  }

  @media (max-width: 640px) {
    :global(.cal-grid) {
      grid-template-columns: repeat(7, minmax(78px, 1fr));
      overflow-x: auto;
    }
    :global(.cal-week) {
      overflow-x: auto;
    }
  }
</style>

<script>
  interface TrainingSession {
    week: number;
    day: string;
    form: 'Running' | 'Swimming' | 'Ski erg' | 'Strength';
    purpose: string;
    plan: string;
    volume: string;
    optional: boolean;
  }

  type WeeklyHours = Record<string, Record<TrainingSession['form'], number>>;

  const sessions: TrainingSession[] = JSON.parse(document.getElementById('training-data')!.textContent!);
  const weeklyHours: WeeklyHours = JSON.parse(document.getElementById('weekly-hours-data')!.textContent!);

  const allForms: TrainingSession['form'][] = ['Running', 'Ski erg', 'Swimming', 'Strength'];

  const state = {
    forms: new Set<TrainingSession['form']>(allForms),
    week: 'all',
    search: '',
    view: 'list' as 'list' | 'calendar',
  };

  const dayNames = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  const dayOrder = Object.fromEntries(dayNames.map((d, i) => [d, i]));

  document.getElementById('weekSelect')!.addEventListener('change', (e) => {
    state.week = (e.target as HTMLSelectElement).value;
    render();
  });

  document.getElementById('searchInput')!.addEventListener('input', (e) => {
    state.search = (e.target as HTMLInputElement).value.toLowerCase();
    render();
  });

  document.querySelectorAll<HTMLButtonElement>('.chip[data-filter="form"]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const val = btn.dataset.value as TrainingSession['form'];
      if (state.forms.has(val)) {
        state.forms.delete(val);
        btn.classList.add('off');
      } else {
        state.forms.add(val);
        btn.classList.remove('off');
      }
      render();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.chip[data-filter="view"]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.chip[data-filter="view"]').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      state.view = btn.dataset.value as 'list' | 'calendar';
      render();
    });
  });

  function getFiltered(): TrainingSession[] {
    return sessions.filter((s) => {
      if (!state.forms.has(s.form)) return false;
      if (state.week !== 'all' && String(s.week) !== state.week) return false;
      if (state.search) {
        const haystack = `${s.plan} ${s.purpose} ${s.form}`.toLowerCase();
        if (!haystack.includes(state.search)) return false;
      }
      return true;
    });
  }

  function groupByWeek(items: TrainingSession[]): Record<number, TrainingSession[]> {
    const byWeek: Record<number, TrainingSession[]> = {};
    for (const s of items) (byWeek[s.week] ??= []).push(s);
    return byWeek;
  }

  function renderList(filtered: TrainingSession[], content: HTMLElement) {
    const byWeek = groupByWeek(filtered);
    for (const w of Object.keys(byWeek).map(Number).sort((a, b) => a - b)) {
      const sessionsForWeek = byWeek[w].sort((a, b) => dayOrder[a.day] - dayOrder[b.day]);
      const weekEl = document.createElement('div');
      weekEl.className = 'week-block';
      weekEl.innerHTML = `
        <div class="week-head">
          <span class="week-title">Week ${w}</span>
          <span class="week-sub">of 5, rolling</span>
        </div>
        ${sessionsForWeek
          .map(
            (s) => `
          <div class="session ${s.optional ? 'optional' : ''}" data-form="${s.form}">
            <div class="s-day">${s.day}</div>
            <div class="s-form">
              <span class="s-form-name">${s.form}</span>
              <span class="s-purpose">${s.purpose}</span>
            </div>
            <div class="s-plan">${s.plan}${s.optional ? '<span class="opt-tag">optional</span>' : ''}</div>
            <div class="s-vol">${s.volume}</div>
          </div>`
          )
          .join('')}
      `;
      content.appendChild(weekEl);
    }
  }

  function renderCalendar(filtered: TrainingSession[], content: HTMLElement) {
    const byWeek = groupByWeek(filtered);
    for (const w of Object.keys(byWeek).map(Number).sort((a, b) => a - b)) {
      const byDay: Record<string, TrainingSession[]> = {};
      dayNames.forEach((d) => (byDay[d] = []));
      byWeek[w].forEach((s) => byDay[s.day].push(s));

      const weekEl = document.createElement('div');
      weekEl.className = 'cal-week';
      weekEl.innerHTML = `
        <div class="cal-title">Week ${w} <span class="week-sub">of 5, rolling</span></div>
        <div class="cal-grid">
          ${dayNames.map((d) => `<div class="cal-day-head">${d}</div>`).join('')}
          ${dayNames
            .map(
              (d) => `
            <div class="cal-day-col">
              ${byDay[d]
                .map(
                  (s) => `
                <div class="cal-pill ${s.optional ? 'optional' : ''}" data-form="${s.form}">
                  <span class="p-form">${s.form}</span>
                  ${s.purpose}
                  <span class="p-vol">${s.volume}</span>
                </div>`
                )
                .join('')}
            </div>`
            )
            .join('')}
        </div>
      `;
      content.appendChild(weekEl);
    }
  }

  function render() {
    const content = document.getElementById('content')!;
    content.innerHTML = '';
    const filtered = getFiltered();

    if (filtered.length === 0) {
      content.innerHTML = '<div class="empty-state">No sessions match the filters.</div>';
      return;
    }

    if (state.view === 'calendar') renderCalendar(filtered, content);
    else renderList(filtered, content);
  }

  function renderChart() {
    const container = document.getElementById('chartContainer')!;
    const colorVar: Record<TrainingSession['form'], string> = {
      Running: 'var(--color-form-run)',
      Swimming: 'var(--color-form-swim)',
      'Ski erg': 'var(--color-form-ski)',
      Strength: 'var(--color-form-strength)',
    };

    const weeks = Object.keys(weeklyHours).sort((a, b) => Number(a) - Number(b));
    const totals = weeks.map((w) => allForms.reduce((sum, f) => sum + weeklyHours[w][f], 0));
    const maxTotal = Math.max(...totals);
    const chartMax = Math.ceil(maxTotal / 2) * 2;

    const width = 640;
    const height = 280;
    const padLeft = 36;
    const padRight = 10;
    const padTop = 10;
    const padBottom = 26;
    const plotH = height - padBottom - padTop;
    const barW = 60;
    const gap = (width - padLeft - padRight - barW * weeks.length) / (weeks.length + 1);

    let svg = `<svg viewBox="0 0 ${width} ${height}">`;

    const steps = 5;
    for (let i = 0; i <= steps; i++) {
      const value = (chartMax / steps) * i;
      const y = padTop + plotH - (value / chartMax) * plotH;
      svg += `<line x1="${padLeft}" y1="${y}" x2="${width - padRight}" y2="${y}" stroke-width="1" />`;
      svg += `<text x="${padLeft - 8}" y="${y + 4}" text-anchor="end" font-size="10">${value.toFixed(0)}h</text>`;
    }

    weeks.forEach((w, i) => {
      const x = padLeft + gap + i * (barW + gap);
      let yCursor = padTop + plotH;
      allForms.forEach((f) => {
        const val = weeklyHours[w][f];
        const barH = (val / chartMax) * plotH;
        yCursor -= barH;
        svg += `<rect x="${x}" y="${yCursor}" width="${barW}" height="${barH}" fill="${colorVar[f]}" />`;
      });
      svg += `<text x="${x + barW / 2}" y="${height - padBottom + 16}" text-anchor="middle" font-size="11">Week ${w}</text>`;
      svg += `<text class="chart-total" x="${x + barW / 2}" y="${padTop + plotH - (totals[i] / chartMax) * plotH - 6}" text-anchor="middle" font-size="10">${totals[i].toFixed(1)}h</text>`;
    });

    svg += `</svg>`;
    container.innerHTML = svg;

    const avg = totals.reduce((a, b) => a + b, 0) / totals.length;
    document.getElementById('chartNote')!.textContent =
      `Average: ${avg.toFixed(1)} h/week across the 5 weeks. Week 3 is highest due to the ÖTILLÖ simulation on the ski erg.`;
  }

  render();
  renderChart();
</script>
